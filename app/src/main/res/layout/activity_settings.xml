<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/settings" android:textAppearance="?android:attr/textAppearanceLarge" android:textStyle="bold" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/gateway_section" android:textStyle="bold" /><Button android:id="@+id/helpGatewayButton" android:layout_width="48dp" android:layout_height="48dp" android:text="?" /></LinearLayout>
<EditText android:id="@+id/gatewayUrlInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/gateway_url_example" android:inputType="textUri" /><EditText android:id="@+id/bootstrapCredentialInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/bootstrap_credential" android:inputType="textPassword" /><Spinner android:id="@+id/authTypeSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" /><Switch android:id="@+id/allowUntrustedTlsSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/allow_untrusted_tls" /><TextView android:id="@+id/untrustedTlsWarning" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/untrusted_tls_warning" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/hermes_section" android:textStyle="bold" />
<EditText android:id="@+id/hermesUrlInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/hermes_url_example" android:inputType="textUri" />
<EditText android:id="@+id/hermesApiKeyInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/hermes_api_key" android:inputType="textPassword" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hermes_key_help" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/hermes_push_section" android:textStyle="bold" />
<EditText android:id="@+id/hermesNtfyServerInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/hermes_ntfy_server" android:inputType="textUri" />
<EditText android:id="@+id/hermesNtfyTopicInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/hermes_ntfy_topic" android:inputType="textNoSuggestions" />
<EditText android:id="@+id/hermesNtfyTokenInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/hermes_ntfy_token" android:inputType="textPassword" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hermes_push_help" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/voice_section" android:textStyle="bold" /><Button android:id="@+id/helpVoiceButton" android:layout_width="48dp" android:layout_height="48dp" android:text="?" /></LinearLayout>
<Spinner android:id="@+id/voiceLanguageSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" /><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><EditText android:id="@+id/manualLanguageTagInput" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="@string/manual_bcp47_hint" /><Button android:id="@+id/helpBcp47Button" android:layout_width="48dp" android:layout_height="48dp" android:text="?" /></LinearLayout>
<Switch android:id="@+id/automaticTtsSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/automatic_tts" /><Switch android:id="@+id/preferLocalSttSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/prefer_local_stt" /><Switch android:id="@+id/allowNetworkSttSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/allow_network_stt" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/conversation_timeout" android:textStyle="bold" /><Spinner android:id="@+id/conversationTimeoutSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><Button android:id="@+id/testVoiceButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/test_voice" /><Button android:id="@+id/voiceDiagnosticsButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/diagnostics" /></LinearLayout><Button android:id="@+id/installVoiceButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/install_voice_data" /><Button android:id="@+id/ttsSettingsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/open_tts_settings" /><Button android:id="@+id/pressAndTalkSettingsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/press_and_talk_settings" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/appearance_section" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_language" /><Spinner android:id="@+id/appLanguageSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/theme" /><Spinner android:id="@+id/themeSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" /><Button android:id="@+id/fullHelpButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/full_help" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/background_section" android:textStyle="bold" /><TextView android:id="@+id/vpnStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="8dp" /><Button android:id="@+id/openTailscaleButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/open_tailscale" /><Button android:id="@+id/openVpnSettingsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/open_vpn_settings" /><Button android:id="@+id/openBatterySettingsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/open_battery_settings" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/always_on_vpn_help" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/notification_section" android:textStyle="bold" /><Button android:id="@+id/helpNotificationsButton" android:layout_width="48dp" android:layout_height="48dp" android:text="?" /></LinearLayout><Switch android:id="@+id/notificationSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/enable_notifications" /><Switch android:id="@+id/urgentNotificationSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/enable_urgent_notifications" /><TextView android:id="@+id/notificationNodeStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="8dp" /><Button android:id="@+id/reconnectNotificationNodeButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/reconnect_notification_node" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/notification_pairing_help" />
<Button android:id="@+id/saveButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/save" />
</LinearLayout></ScrollView>

